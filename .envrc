#!/bin/bash

if [[ $(hostname) == "alicecerno2" || $(hostname) == "alipap1" ]] && [[ -z ${ROOTSYS} ]]; then

  PYTHON_VERSION=3.10.14
  ROOT_VERSION=v6-32-04
  ROOUNFOLD_VERSION=2.0.1

  PREFIX=/home/pyadmin/software_mlhep
  layout python ${PREFIX}/install/pyenv/versions/${PYTHON_VERSION}/bin/python3
  path_add PYTHONPATH ${PREFIX}/install/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  PATH_add ${PREFIX}/install/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/bin
  path_add LD_LIBRARY_PATH ${PREFIX}/install/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  # path_add LD_LIBRARY_PATH ${PREFIX}/install/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  path_add LD_LIBRARY_PATH ${PREFIX}/build/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}

elif [[ $(hostname) == "maja-Latitude-5430" ]] && [[ -z ${ROOTSYS} ]]; then

  PYTHON_VERSION=3.12.7
  ROOT_VERSION=6-32-08
  ROOUNFOLD_VERSION=2.0.1

  PREFIX=/home/maja/CERN_part/CERN/

  layout python /usr/bin/python3

  #path_add PYTHONPATH /usr/lib/python3.12/
  #PATH_add /usr/bin
  path_add LD_LIBRARY_PATH ${PREFIX}/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  # path_add LD_LIBRARY_PATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  path_add LD_LIBRARY_PATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/build
  path_add PYTHONPATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/build

elif [[ $(hostname) == "alicewm7.fizyka.pw.edu.pl" ]] && [[ -z ${ROOTSYS} ]]; then

  PYTHON_VERSION=3.10.12
  ROOT_VERSION=v6-32-04
  ROOUNFOLD_VERSION=2.0.1

  PREFIX=/home/maja/

  layout python /usr/bin/python3

  #path_add PYTHONPATH /usr/lib/python3.12/
  #PATH_add /usr/bin
  PATH_add ${PREFIX}/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/bin
  path_add LD_LIBRARY_PATH ${PREFIX}/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  path_add PYTHONPATH ${PREFIX}/root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  # path_add LD_LIBRARY_PATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/lib
  path_add LD_LIBRARY_PATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/build
  path_add PYTHONPATH ${PREFIX}/RooUnfold-${ROOUNFOLD_VERSION}_root-${ROOT_VERSION}_py-${PYTHON_VERSION}/build

fi
